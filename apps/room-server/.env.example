# Copy to .env (git-ignored). Everything is optional locally; defaults are safe.
PORT=8787

# ── Production ────────────────────────────────────────────────────────────────
# ALLOWED_ORIGINS=https://your-site.netlify.app
# DATABASE_URL=postgres://user:pass@host:5432/db
# PUBLIC_WEB_URL=https://your-site.netlify.app
# Behind Railway/Render/Fly, set this so rate limits see real client IPs.
# Leave it OFF when nothing sits in front of the server (the header is then spoofable).
# TRUST_PROXY=true

# ── Payments (optional) ──────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Abuse limits (per client IP; defaults are CGNAT-friendly) ────────────────
# LIMIT_SOCKETS_PER_IP=120      # open WebSockets at once
# LIMIT_ROOM_CREATES=15         # new rooms per 10 minutes
# LIMIT_JOINS=60                # join attempts per minute (stops code guessing)
# LIMIT_API=300                 # /api requests per minute
# LIMIT_PROFILE_CREATES=100     # new guest profiles per hour
# LIMIT_CHECKOUTS=10            # Stripe checkouts per 10 minutes

# ── Bots ─────────────────────────────────────────────────────────────────────
# How long bots "think", as % of normal. Lower it to play-test faster locally.
# Ignored in production (always 100).
# BOT_DELAY_PERCENT=100
